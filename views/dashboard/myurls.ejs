<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My URLs | ShortURL</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/myurls.css">
</head>
<body>

<%- include("../partials/sidebar") %>

<main class="main-content">

    <div class="page-header">
        <h1><i class="fas fa-link"></i> My URLs</h1>
        <p>Manage, search, edit, and organize all your active shortened links.</p>
    </div>

    <div class="toolbar">
        <div class="search-wrap">
            <i class="fas fa-search"></i>
            <input
                type="text"
                id="searchInput"
                placeholder="Search by short URL or destination..."
            >
        </div>
    </div>

    <div class="table-card">
        <div class="table-wrapper">
            <table id="urlTable">
                <thead>
                    <tr>
                        <th>Short URL</th>
                        <th>Destination URL</th>
                        <th>Clicks</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                <% if(urls && urls.length > 0){ %>
                    <% urls.forEach(url => { %>
                    <tr>
                        <td>
                            <a href="/<%= url.shortUrl %>" target="_blank" class="short-url-link">
                                <i class="fas fa-link"></i> <%= url.shortUrl %>
                            </a>
                        </td>

                        <td>
                            <span class="original-url-text" title="<%= url.originalUrl %>">
                                <%= url.originalUrl %>
                            </span>
                        </td>

                        <td>
                            <span class="clicks-badge">
                                <i class="fas fa-mouse-pointer"></i> <%= url.clicks %>
                            </span>
                        </td>

                        <td>
                            <span class="created-date-text">
                                <i class="fas fa-calendar-alt"></i> <%= new Date(url.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                            </span>
                        </td>

                        <td>
                            <div class="actions-cell">
                                <button
                                    class="action-btn copy"
                                    title="Copy Short URL"
                                    onclick="copyURL('<%= url.shortUrl %>')">
                                    <i class="fas fa-copy"></i>
                                </button>

                                <button
                                    class="action-btn edit"
                                    title="Edit Destination"
                                    onclick="editURL('<%= url._id %>', '<%= url.originalUrl %>')">
                                    <i class="fas fa-pen"></i>
                                </button>

                                <button
                                    class="action-btn delete"
                                    title="Delete URL"
                                    onclick="deleteURL('<%= url._id %>')">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="empty-cell">
                            <i class="fas fa-inbox"></i>
                            <p>No shortened URLs created yet.</p>
                        </td>
                    </tr>
                <% } %>
                </tbody>
            </table>
        </div>
    </div>

</main>

<!-- Edit Modal -->
<div id="editModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Edit Destination URL</h2>
            <button class="close-btn" onclick="closeModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="modal-body">
            <label for="editOriginalUrl">Original Destination URL</label>
            <input
                type="url"
                id="editOriginalUrl"
                placeholder="https://example.com/your-long-url"
                required
            >
        </div>

        <div class="modal-footer">
            <button
                class="cancel-btn"
                onclick="closeModal()">
                Cancel
            </button>

            <button
                id="saveBtn"
                class="save-btn"
                onclick="saveEdit()">
                <i class="fas fa-save"></i>
                <span>Save Changes</span>
            </button>
        </div>
    </div>
</div>

<!-- Toast -->
<div id="toast" class="toast">
    <i class="fas fa-check-circle"></i>
    <span id="toastMessage">Success</span>
</div>
            
<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal">
    <div class="modal-content delete-modal">
        <div class="delete-icon">
            <i class="fas fa-trash-alt"></i>
        </div>

        <h2>Delete URL?</h2>

        <p>
            Are you sure you want to delete this short URL? This link will stop redirecting immediately.
        </p>

        <div class="modal-footer" style="justify-content: center;">
            <button
                class="cancel-btn"
                onclick="closeDeleteModal()">
                Cancel
            </button>

            <button
                class="delete-confirm-btn"
                onclick="confirmDelete()">
                <i class="fas fa-trash"></i> Delete
            </button>
        </div>
    </div>
</div>

<script>
const searchInput = document.getElementById("searchInput");

if (searchInput) {
    searchInput.addEventListener("keyup", function() {
        const filter = this.value.toLowerCase();
        const rows = document.querySelectorAll("#urlTable tbody tr");

        rows.forEach(row => {
            if (row.querySelector('.empty-cell')) return;
            row.style.display = row.innerText.toLowerCase().includes(filter) ? "" : "none";
        });
    });
}

let currentEditId = "";

function copyURL(short) {
    const full = window.location.origin + "/" + short;
    navigator.clipboard.writeText(full).then(() => {
        showToast("URL Copied to Clipboard!");
    }).catch(() => {
        showToast("Copied: " + full);
    });
}

let currentDeleteId = "";

function deleteURL(id) {
    currentDeleteId = id;
    document.getElementById("deleteModal").style.display = "flex";
}

async function confirmDelete() {
    try {
        const res = await fetch("/url/delete/" + currentDeleteId, {
            method: "DELETE"
        });

        if (res.ok) {
            showToast("URL Deleted Successfully");
            setTimeout(() => {
                location.reload();
            }, 700);
        } else {
            showToast("Failed to delete URL");
        }
    } catch (e) {
        showToast("Network error");
    }
    closeDeleteModal();
}  

function closeDeleteModal() {
    document.getElementById("deleteModal").style.display = "none";
} 

function closeModal() {
    const modal = document.getElementById("editModal");
    modal.style.display = "none";
}

function editURL(id, originalUrl) {
    currentEditId = id;
    document.getElementById("editOriginalUrl").value = originalUrl;
    document.getElementById("editModal").style.display = "flex";
    document.getElementById("editOriginalUrl").focus();
}

async function saveEdit() {
    const input = document.getElementById("editOriginalUrl");
    const saveBtn = document.getElementById("saveBtn");
    const originalUrl = input.value.trim();

    if (!originalUrl) {
        showToast("Please enter a valid destination URL");
        input.focus();
        return;
    }

    try {
        saveBtn.disabled = true;
        saveBtn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> <span>Saving...</span>`;

        const res = await fetch("/url/edit/" + currentEditId, {
            method: "PUT",
            headers: {
                "Content-Type": "application/json",
            },
            body: JSON.stringify({ originalUrl }),
        });

        if (res.ok) {
            showToast("URL Updated Successfully!");
            setTimeout(() => {
                location.reload();
            }, 800);
        } else {
            showToast("Update failed");
            saveBtn.disabled = false;
            saveBtn.innerHTML = `<i class="fas fa-save"></i> <span>Save Changes</span>`;
        }
    } catch (err) {
        showToast("Something went wrong");
        saveBtn.disabled = false;
        saveBtn.innerHTML = `<i class="fas fa-save"></i> <span>Save Changes</span>`;
    }
}
                        
function showToast(message) {
    const toast = document.getElementById("toast");
    document.getElementById("toastMessage").innerText = message;
    toast.classList.add("show");

    setTimeout(() => {
        toast.classList.remove("show");
    }, 2500);
}

document.addEventListener("keydown", function(e) {
    if (e.key === "Escape") {
        closeModal();
        closeDeleteModal();
    }
});

window.onclick = function(e) {
    const editModal = document.getElementById("editModal");
    const deleteModal = document.getElementById("deleteModal");
    if (e.target === editModal) closeModal();
    if (e.target === deleteModal) closeDeleteModal();
}
</script>

</body>
</html>