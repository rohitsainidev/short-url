<!-- ========================================================
     SIMPLE & PROFESSIONAL PRELOADER
     ======================================================== -->
<link rel="stylesheet" href="/css/preloader.css">

<div id="page-preloader" aria-label="Loading page...">
    <div class="preloader-content">
        <!-- Clean Brand Identity -->
        <div class="preloader-logo">
            <div class="preloader-icon">
                <i class="fas fa-link"></i>
            </div>
            <div class="preloader-brand-text">Short<span>URL</span></div>
        </div>

        <!-- Modern Sleek Spinner -->
        <div class="preloader-spinner-wrap">
            <div class="preloader-spinner"></div>
        </div>
    </div>
</div>

<script>
    (function () {
        const preloader = document.getElementById('page-preloader');
        if (!preloader) return;

        let hidden = false;
        function dismissPreloader() {
            if (hidden) return;
            hidden = true;
            preloader.classList.add('preloader-fade-out');
            setTimeout(function () {
                preloader.classList.add('preloader-hidden');
            }, 320);
        }

        if (document.readyState === 'complete') {
            setTimeout(dismissPreloader, 150);
        } else {
            window.addEventListener('load', function () {
                setTimeout(dismissPreloader, 200);
            });
        }

        // Safety fallback (never stays more than 2 seconds)
        setTimeout(dismissPreloader, 2000);
    })();
</script>