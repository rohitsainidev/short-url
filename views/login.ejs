<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In | ShortURL</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }

        html, body {
            height: 100%;
            background: #0a0a1a;
            overflow: hidden;
        }

        /* ─── LAYOUT ─── */
        .page {
            display: flex;
            height: 100vh;
            width: 100vw;
        }

        /* ─── LEFT: FORM PANEL ─── */
        .form-panel {
            width: 46%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 52px;
            background: #0a0a1a;
            position: relative;
            z-index: 2;
        }

        /* Grid lines same as rest of site */
        .form-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: 50px 50px;
            pointer-events: none;
        }

        /* Same orb style as rest of site */
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
        }
        .orb-1 { width: 320px; height: 320px; background: #6c3ce0; top: -80px; left: -80px; opacity: 0.12; }
        .orb-2 { width: 250px; height: 250px; background: #00d4ff; bottom: -60px; right: -60px; opacity: 0.08; }

        .form-inner {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 370px;
        }

        /* Logo */
        .logo {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            text-decoration: none;
            margin-bottom: 30px;
            transition: transform 0.25s ease;
        }
        .logo:hover {
            transform: translateY(-1px);
        }
        .logo-icon {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, #6c3ce0, #a855f7);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 16px;
            box-shadow: 0 4px 20px rgba(108,60,224,0.45);
            border: 1px solid rgba(255,255,255,0.15);
        }
        .logo-text { font-size: 20px; font-weight: 800; color: #fff; letter-spacing: -0.3px; }
        .logo-text span {
            background: linear-gradient(135deg, #a855f7, #c084fc);
            background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        /* Title */
        .title { margin-bottom: 24px; }
        .title h1 {
            font-size: 26px; font-weight: 800; color: #fff;
            margin-bottom: 5px; letter-spacing: -0.5px;
        }
        .title p { font-size: 13.5px; color: rgba(255,255,255,0.45); line-height: 1.4; }

        /* Form */
        .form-group { margin-bottom: 15px; }
        .form-group label {
            display: block; font-size: 11.5px; font-weight: 600;
            color: rgba(255,255,255,0.6); margin-bottom: 6px; letter-spacing: 0.2px;
        }
        .input-wrap { position: relative; display: flex; align-items: center; }
        .input-wrap i.ico {
            position: absolute; left: 14px; top: 50%; transform: translateY(-50%);
            color: rgba(255,255,255,0.25); font-size: 13px; pointer-events: none;
            transition: all 0.25s ease;
        }
        .input-wrap input {
            width: 100%; height: 44px;
            padding: 0 14px 0 40px;
            background: rgba(255,255,255,0.035);
            border: 1.5px solid rgba(255,255,255,0.08);
            border-radius: 10px; font-size: 13.5px; color: #fff; outline: none;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .input-wrap input::placeholder { color: rgba(255,255,255,0.2); }
        .input-wrap input:hover {
            border-color: rgba(255,255,255,0.15);
            background: rgba(255,255,255,0.045);
        }
        .input-wrap input:focus {
            border-color: #a855f7;
            background: rgba(168,85,247,0.04);
            box-shadow: 0 0 0 4px rgba(168,85,247,0.15), 0 0 20px rgba(168,85,247,0.12);
        }
        .input-wrap:focus-within i.ico {
            color: #c084fc;
            transform: translateY(-50%) scale(1.15);
        }
        .toggle-pwd {
            position: absolute; right: 13px; top: 50%; transform: translateY(-50%);
            background: none; border: none;
            color: rgba(255,255,255,0.25); cursor: pointer; font-size: 13px;
            padding: 4px; transition: color 0.2s;
        }
        .toggle-pwd:hover { color: #c084fc; }

        /* Options */
        .options {
            display: flex; justify-content: space-between;
            align-items: center; margin: 14px 0 20px;
        }
        .remember { display: flex; align-items: center; gap: 7px; cursor: pointer; }
        .remember input {
            width: 14px; height: 14px; accent-color: #7c3aed; cursor: pointer;
        }
        .remember span { font-size: 12px; color: rgba(255,255,255,0.48); user-select: none; }
        .forgot {
            font-size: 12px; color: #a855f7; text-decoration: none;
            font-weight: 500; transition: all 0.2s ease;
        }
        .forgot:hover {
            color: #c084fc; text-shadow: 0 0 10px rgba(192,132,252,0.4);
        }

        /* Submit */
        .btn-signin {
            width: 100%; height: 44px; border: none; border-radius: 10px;
            background: linear-gradient(135deg, #7c3aed, #a855f7);
            color: #fff; font-size: 14.5px; font-weight: 600; letter-spacing: 0.2px;
            cursor: pointer; display: flex; align-items: center;
            justify-content: center; gap: 8px;
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative; overflow: hidden;
            box-shadow: 0 4px 18px rgba(124,58,237,0.35);
        }
        .btn-signin::after {
            content: '';
            position: absolute; top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);
            transition: left 0.55s;
        }
        .btn-signin:hover::after { left: 100%; }
        .btn-signin:hover {
            transform: translateY(-2px);
            background: linear-gradient(135deg, #8b5cf6, #c084fc);
            box-shadow: 0 8px 28px rgba(168,85,247,0.5);
        }

        /* Divider */
        .divider { display: flex; align-items: center; gap: 10px; margin: 16px 0; }
        .divider::before, .divider::after {
            content: ''; flex: 1; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
        }
        .divider span {
            font-size: 10.5px; color: rgba(255,255,255,0.3);
            letter-spacing: 1px; text-transform: uppercase; font-weight: 500;
        }

        /* Google */
        .btn-google {
            width: 100%; height: 46px;
            border: none;
            border-radius: 12px;
            background: #ffffff;
            color: #1e293b;
            font-size: 14.5px; font-weight: 600;
            cursor: pointer; display: flex; align-items: center;
            justify-content: center; gap: 10px;
            text-decoration: none;
            box-shadow: 0 4px 16px rgba(0,0,0,0.35);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .btn-google:hover {
            background: #f8fafc;
            color: #0f172a;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(255, 255, 255, 0.18), 0 2px 8px rgba(0, 0, 0, 0.3);
        }
        .btn-google:active {
            transform: translateY(0);
            background: #e2e8f0;
        }

        /* Sign up */
        .signup-row {
            text-align: center; margin-top: 18px;
            font-size: 13px; color: rgba(255,255,255,0.4);
        }
        .signup-row a {
            color: #a855f7; text-decoration: none; font-weight: 600;
            transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 4px;
        }
        .signup-row a:hover {
            color: #c084fc; text-shadow: 0 0 10px rgba(192,132,252,0.4);
            transform: translateX(1px);
        }

        /* Message */
        .msg { padding: 10px 14px; border-radius: 10px; font-size: 13px; font-weight: 500; margin-bottom: 16px; display: none; align-items: center; gap: 9px; }
        .msg.error {
            display: flex;
            background: rgba(239,68,68,0.08);
            color: #f87171;
            border: 1px solid rgba(239,68,68,0.2);
            border-left: 3px solid #ef4444;
        }

        /* Success toast */
        .msg.success {
            display: flex;
            background: rgba(34,197,94,0.07);
            color: #4ade80;
            border: 1px solid rgba(34,197,94,0.18);
            border-left: 3px solid #22c55e;
            box-shadow: 0 0 20px rgba(34,197,94,0.08);
            animation: toastIn 0.4s cubic-bezier(0.34,1.56,0.64,1) forwards;
        }
        .msg.success i {
            background: rgba(34,197,94,0.15);
            border-radius: 50%;
            width: 24px; height: 24px;
            display: flex; align-items: center; justify-content: center;
            font-size: 12px; flex-shrink: 0;
            color: #22c55e;
        }
        .msg.success .success-text { display: flex; flex-direction: column; gap: 1px; }
        .msg.success .success-title { font-size: 13px; font-weight: 700; color: #4ade80; }
        .msg.success .success-sub   { font-size: 11px; color: rgba(74,222,128,0.65); }
        @keyframes toastIn {
            from { opacity: 0; transform: translateY(-8px) scale(0.97); }
            to   { opacity: 1; transform: translateY(0)   scale(1); }
        }

        /* ── FLOATING TOAST ── */
        #successToast {
            position: fixed;
            top: 24px;
            right: 24px;
            z-index: 9999;
            min-width: 300px;
            max-width: 360px;
            background: #0e1a14;
            border: 1px solid rgba(34,197,94,0.25);
            border-left: 4px solid #22c55e;
            border-radius: 14px;
            padding: 16px 18px 14px;
            box-shadow:
                0 0 0 1px rgba(34,197,94,0.08),
                0 20px 60px rgba(0,0,0,0.6),
                0 0 30px rgba(34,197,94,0.08);
            display: flex;
            align-items: flex-start;
            gap: 13px;
            animation: toastSlideIn 0.45s cubic-bezier(0.34,1.56,0.64,1) forwards;
            pointer-events: none;
        }
        #successToast.hide {
            animation: toastSlideOut 0.4s ease forwards;
        }
        @keyframes toastSlideIn {
            from { opacity: 0; transform: translateX(110%); }
            to   { opacity: 1; transform: translateX(0); }
        }
        @keyframes toastSlideOut {
            from { opacity: 1; transform: translateX(0); }
            to   { opacity: 0; transform: translateX(110%); }
        }
        .toast-icon {
            width: 36px; height: 36px; flex-shrink: 0;
            background: rgba(34,197,94,0.12);
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            color: #22c55e; font-size: 16px;
        }
        .toast-body { flex: 1; }
        .toast-title {
            font-size: 14px; font-weight: 700;
            color: #fff; margin-bottom: 3px;
        }
        .toast-sub {
            font-size: 12px;
            color: rgba(255,255,255,0.42);
        }
        /* Progress bar */
        .toast-progress {
            position: absolute;
            bottom: 0; left: 0;
            height: 3px;
            border-radius: 0 0 14px 14px;
            background: linear-gradient(90deg, #22c55e, #4ade80);
            animation: toastProgress 4s linear forwards;
        }
        @keyframes toastProgress {
            from { width: 100%; }
            to   { width: 0%; }
        }

        /* ─── RIGHT: IMAGE PANEL ─── */
        .image-panel {
            width: 54%;
            position: relative;
            background: #08081e;
            overflow: hidden;
        }

        /* same grid on right too */
        .image-panel::before {
            content: '';
            position: absolute; inset: 0; z-index: 1;
            background-image:
                linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
            background-size: 50px 50px;
        }

        /* purple glow top-right */
        .image-panel .glow-tr {
            position: absolute; top: -100px; right: -100px; z-index: 1;
            width: 500px; height: 500px; border-radius: 50%;
            background: radial-gradient(circle, rgba(108,60,224,0.2) 0%, transparent 65%);
        }
        /* cyan glow bottom-left */
        .image-panel .glow-bl {
            position: absolute; bottom: -80px; left: -80px; z-index: 1;
            width: 400px; height: 400px; border-radius: 50%;
            background: radial-gradient(circle, rgba(0,212,255,0.1) 0%, transparent 65%);
        }

        /* Clean styled frame */
        .image-frame {
            position: absolute; inset: 0; z-index: 2;
            display: flex; align-items: center; justify-content: center;
            padding: 48px;
        }

        /* Ambient floating glowing wrap */
        .img-ring-wrap {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            max-width: 520px;
            max-height: 75vh;
            animation: floatLevitate 5s ease-in-out infinite alternate;
            will-change: transform;
        }

        /* Subtle animated gradient border */
        .img-ring-wrap::before {
            content: '';
            position: absolute;
            inset: -2px;
            border-radius: 22px;
            background: linear-gradient(135deg, rgba(168, 85, 247, 0.7), rgba(0, 212, 255, 0.5), rgba(108, 60, 224, 0.7));
            background-size: 200% 200%;
            animation: gradientFlow 6s ease infinite;
            z-index: 0;
        }

        /* Soft ambient aura blur */
        .img-ring-wrap::after {
            content: '';
            position: absolute;
            inset: -6px;
            border-radius: 26px;
            background: linear-gradient(135deg, rgba(168, 85, 247, 0.4), rgba(0, 212, 255, 0.3), rgba(108, 60, 224, 0.4));
            background-size: 200% 200%;
            filter: blur(18px);
            opacity: 0.65;
            animation: gradientFlow 6s ease infinite;
            z-index: 0;
        }

        @keyframes gradientFlow {
            0%   { background-position: 0% 50%; }
            50%  { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .img-inner {
            position: relative;
            z-index: 1;
            width: 100%;
            border-radius: 20px;
            overflow: hidden;
            background: #08081e;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
        }

        .img-inner img {
            width: 100%;
            max-height: 75vh;
            object-fit: contain;
            border-radius: 20px;
            display: block;
            position: relative;
            z-index: 1;
        }

        /* Subtle glass sheen */
        .img-inner::after {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 50%; height: 100%;
            background: linear-gradient(
                105deg,
                transparent 30%,
                rgba(255,255,255,0.05) 50%,
                transparent 70%
            );
            animation: shimmerSweep 4s ease-in-out infinite;
            z-index: 2;
            border-radius: 20px;
            pointer-events: none;
        }

        @keyframes shimmerSweep {
            0%   { left: -100%; }
            40%  { left: 150%; }
            100% { left: 150%; }
        }

        /* Silky smooth levitation */
        @keyframes floatLevitate {
            0% {
                transform: translateY(0px);
            }
            100% {
                transform: translateY(-12px);
            }
        }

        /* Floating ambient dust particles */
        .particle {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            z-index: 3;
            animation: particleFloat linear infinite;
            opacity: 0;
        }
        @keyframes particleFloat {
            0%   { transform: translateY(0) scale(0); opacity: 0; }
            15%  { opacity: 0.5; }
            85%  { opacity: 0.3; }
            100% { transform: translateY(-80px) scale(1.2); opacity: 0; }
        }

        /* Hero Feature Badge Card */
        .hero-feature-card {
            position: absolute;
            bottom: 36px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 4;
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(10, 10, 26, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 14px;
            padding: 12px 18px;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 20px rgba(124, 58, 237, 0.15);
            width: max-content;
            max-width: 88%;
        }
        .hero-feature-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: linear-gradient(135deg, #7c3aed, #a855f7);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 14px;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(124, 58, 237, 0.4);
        }
        .hero-feature-text {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .hero-feature-title {
            color: #ffffff;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: -0.2px;
        }
        .hero-feature-sub {
            color: rgba(255, 255, 255, 0.5);
            font-size: 11.5px;
        }

        /* Separator line between panels */
        .divider-line {
            position: absolute; left: 46%; top: 10%; bottom: 10%;
            width: 1px;
            background: linear-gradient(to bottom, transparent, rgba(168,85,247,0.25), transparent);
            z-index: 3;
        }

        /* ─── RESPONSIVE: BALANCED MOBILE VIEW ─── */
        @media (max-width: 900px) {
            html, body {
                overflow-x: hidden !important;
                overflow-y: auto !important;
                min-height: 100% !important;
                min-height: 100dvh !important;
                height: auto !important;
            }
            .page {
                min-height: 100vh !important;
                min-height: 100dvh !important;
                height: auto !important;
                overflow-x: hidden !important;
                overflow-y: auto !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
            }
            .image-panel { display: none !important; }
            .divider-line { display: none !important; }
            .form-panel {
                width: 100% !important;
                min-height: 100vh !important;
                min-height: 100dvh !important;
                height: auto !important;
                padding: 42px 24px 38px !important;
                overflow: visible !important;
                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
                justify-content: center !important;
            }
            .form-inner {
                max-width: 380px !important;
                width: 100% !important;
                margin: auto 0 !important;
            }
            .logo {
                margin-bottom: 22px !important;
            }
            .logo-icon {
                width: 36px !important;
                height: 36px !important;
                font-size: 15px !important;
                border-radius: 10px !important;
            }
            .logo-text {
                font-size: 20px !important;
            }
            .title {
                margin-bottom: 22px !important;
            }
            .title h1 {
                font-size: 25px !important;
                margin-bottom: 5px !important;
            }
            .title p {
                font-size: 13.5px !important;
            }
            .form-group {
                margin-bottom: 15px !important;
            }
            .form-group label {
                font-size: 12px !important;
                margin-bottom: 6px !important;
            }
            .input-wrap input {
                height: 46px !important;
                font-size: 14px !important;
                border-radius: 11px !important;
                padding: 0 14px 0 40px !important;
            }
            .input-wrap i.ico {
                font-size: 13px !important;
                left: 14px !important;
            }
            .options {
                margin: 14px 0 18px !important;
            }
            .remember span {
                font-size: 12px !important;
            }
            .forgot {
                font-size: 12px !important;
            }
            .btn-signin {
                height: 46px !important;
                font-size: 15px !important;
                border-radius: 11px !important;
            }
            .divider {
                margin: 16px 0 !important;
            }
            .divider span {
                font-size: 11px !important;
            }
            .btn-google {
                height: 46px !important;
                font-size: 14px !important;
                border-radius: 11px !important;
                font-weight: 600 !important;
                background: #ffffff !important;
                color: #1e293b !important;
                box-shadow: 0 4px 18px rgba(0,0,0,0.3) !important;
            }
            .signup-row {
                margin-top: 18px !important;
                font-size: 13px !important;
            }
        }
    </style>
</head>
<body>
    <%- include("partials/preloader") %>

    <div class="page">

        <!-- ─── LEFT: FORM ─── -->
        <div class="form-panel">
            <div class="orb orb-1"></div>
            <div class="orb orb-2"></div>

            <div class="form-inner">

                <a href="/" class="logo">
                    <div class="logo-icon"><i class="fas fa-link"></i></div>
                    <span class="logo-text">Short<span>URL</span></span>
                </a>

                <div class="title">
                    <h1>Welcome back</h1>
                    <p>Sign in to manage your short links</p>
                </div>

                <!-- Server-side messages -->
                <% if (typeof error !== 'undefined' && error) { %>
                <div class="msg error" style="display:flex;">
                    <i class="fas fa-exclamation-circle"></i>
                    <span><%= error %></span>
                </div>
                <% } %>

                <!-- JS messages -->
                <div class="msg" id="msg">
                    <i class="fas" id="msgIcon"></i>
                    <span id="msgText"></span>
                </div>

                <form action="/user/login" method="POST" id="loginForm">

                    <div class="form-group">
                        <label for="email">Email address</label>
                        <div class="input-wrap">
                            <i class="fas fa-envelope ico"></i>
                            <input type="email" id="email" name="email"
                                placeholder="you@example.com" required autocomplete="email" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="input-wrap">
                            <i class="fas fa-lock ico"></i>
                            <input type="password" id="password" name="password"
                                placeholder="••••••••" required autocomplete="current-password" />
                            <button type="button" class="toggle-pwd" id="togglePwd">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="options">
                        <label class="remember">
                            <input type="checkbox" name="remember" />
                            <span>Remember me</span>
                        </label>
                        <a href="/user/forgot-password" class="forgot">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-signin" id="submitBtn">
                        <i class="fas fa-arrow-right-to-bracket"></i> Sign In
                    </button>

                </form>

                <div class="divider"><span>or</span></div>

                <a href="/auth/google" class="btn-google">
                    <svg width="18" height="18" viewBox="0 0 24 24" style="flex-shrink:0;">
                        <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/>
                        <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
                        <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 10.03 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
                        <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
                    </svg>
                    <span>Continue with Google</span>
                </a>

                <div class="signup-row">
                    Don't have an account? <a href="/user/signup">Create one free <i class="fas fa-arrow-right" style="font-size:11px; margin-left:2px;"></i></a>
                </div>

            </div>
        </div>

        <!-- Vertical separator -->
        <div class="divider-line"></div>

        <!-- ─── RIGHT: IMAGE ─── -->
        <div class="image-panel" id="imagePanel">
            <div class="glow-tr"></div>
            <div class="glow-bl"></div>

            <div class="image-frame">
                <div class="img-ring-wrap">
                    <div class="img-inner">
                        <img src="/login-hero.jpg" alt="ShortURL visual" />
                    </div>
                </div>
            </div>
        </div>

    </div>

    <script>
        // ── Floating particles ──
        const panel = document.getElementById('imagePanel');
        const colors = ['#a855f7','#6c3ce0','#00d4ff','#c084fc','#ffffff'];
        for (let i = 0; i < 18; i++) {
            const p = document.createElement('div');
            p.className = 'particle';
            const size = Math.random() * 5 + 2;
            p.style.cssText = `
                width:${size}px; height:${size}px;
                background:${colors[Math.floor(Math.random()*colors.length)]};
                left:${Math.random()*90+5}%;
                bottom:${Math.random()*30}%;
                animation-duration:${Math.random()*3+2.5}s;
                animation-delay:${Math.random()*4}s;
            `;
            panel.appendChild(p);
        }
        document.getElementById('togglePwd').addEventListener('click', function () {
            const inp = document.getElementById('password');
            inp.type = inp.type === 'password' ? 'text' : 'password';
            this.querySelector('i').classList.toggle('fa-eye');
            this.querySelector('i').classList.toggle('fa-eye-slash');
        });

        document.getElementById('loginForm').addEventListener('submit', function (e) {
            const email = document.getElementById('email').value.trim();
            const pass  = document.getElementById('password').value;

            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                e.preventDefault();
                showMsg('error', 'fa-exclamation-circle', 'Please enter a valid email address');
                return;
            }
            if (pass.length < 4) {
                e.preventDefault();
                showMsg('error', 'fa-exclamation-circle', 'Password must be at least 4 characters');
                return;
            }

            e.preventDefault();
            const btn = document.getElementById('submitBtn');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Signing in...';
            btn.style.opacity = '0.8';
            btn.style.pointerEvents = 'none';
            setTimeout(() => this.submit(), 1200);
        });

        function showMsg(type, icon, text) {
            const el = document.getElementById('msg');
            el.className = 'msg ' + type;
            document.getElementById('msgIcon').className = 'fas ' + icon;
            document.getElementById('msgText').textContent = text;
            el.style.display = 'flex';
            if (type === 'success') setTimeout(() => el.style.display = 'none', 5000);
        }

        // ── Success Toast auto-dismiss ──
        const toast = document.getElementById('successToast');
        if (toast) {
            setTimeout(() => {
                toast.classList.add('hide');
                setTimeout(() => toast.remove(), 400);
            }, 4000);
        }
    </script>

    <!-- ── FLOATING SUCCESS TOAST ── -->
    <% if (typeof success !== 'undefined' && success) { %>
    <div id="successToast">
        <div class="toast-icon">
            <i class="fas fa-check"></i>
        </div>
        <div class="toast-body">
            <div class="toast-title">Account created successfully!</div>
            <div class="toast-sub">You can now sign in with your credentials.</div>
        </div>
        <div class="toast-progress"></div>
    </div>
    <% } %>

</body>
</html>